<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|top"
    android:paddingTop="32dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/quickspace_split_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <com.android.launcher3.quickspace.views.AccentedTextClock
        android:id="@+id/quickspace_clock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        android:autoSizeMaxTextSize="64sp"
        android:autoSizeMinTextSize="32sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?workspaceTextColor"
        android:textSize="64sp"
        app:layout_constraintEnd_toStartOf="@id/quickspace_split_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/quickspace_split_rule"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.35"
        android:background="?workspaceTextColor"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/quickspace_clock"
        app:layout_constraintStart_toStartOf="@id/quickspace_split_guideline"
        app:layout_constraintTop_toTopOf="@id/quickspace_clock" />

    <TextView
        android:id="@+id/quickspace_day_of_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@*android:string/config_headlineFontFamily"
        android:includeFontPadding="false"
        android:textColor="?workspaceTextColor"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickspace_split_rule"
        app:layout_constraintTop_toTopOf="@id/quickspace_clock" />

    <TextView
        android:id="@+id/quickspace_date"
        style="@style/QuickSpaceSubText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@*android:string/config_bodyFontFamily"
        android:includeFontPadding="false"
        android:textColor="?workspaceTextColor"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/quickspace_day_of_week"
        app:layout_constraintStart_toStartOf="@id/quickspace_day_of_week"
        app:layout_constraintTop_toBottomOf="@id/quickspace_day_of_week" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/quickspace_split_header_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_clock,quickspace_date" />

    <include
        android:id="@+id/quick_event_weather_content"
        layout="@layout/quickspace_weather_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_split_header_barrier" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/date_weather_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_clock,quickspace_date,quick_event_weather_content" />

    <include
        layout="@layout/quickspace_calendar_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_weather_barrier" />

    <include
        android:id="@+id/quickspace_minimal_icons_row"
        layout="@layout/quickspace_minimal_icons_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_calendar_content" />

    <include
        android:id="@+id/quickspace_weather_expanded_row"
        layout="@layout/quickspace_weather_expanded_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_minimal_icons_row" />

    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:paddingStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_weather_expanded_row">

        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music_note_24dp"
                android:tint="?workspaceTextColor" />

            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:singleLine="true"
                android:textColor="?workspaceTextColor"
                android:textSize="@dimen/quickspace_subtitle_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/quickspace_psa_message"
            style="@style/QuickSpaceSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_bodyFontFamily"
            android:textColor="?workspaceTextColor"
            android:textSize="@dimen/quickspace_subtitle_size"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/expanded_content_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_calendar_content,quickspace_minimal_icons_row,quickspace_weather_expanded_row,contextual_info_row" />

    <FrameLayout
        android:id="@+id/battery_info_row"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_battery_pill"
        android:clipChildren="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/expanded_content_barrier">

        <FrameLayout
            android:id="@+id/battery_progress_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_battery_progress"
            android:clipToOutline="true">

            <View
                android:id="@+id/battery_shimmer_view"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_battery_shimmer"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/battery_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.6"
                    android:src="@drawable/ic_battery_std"
                    android:tint="?workspaceTextColor" />

                <ImageView
                    android:id="@+id/battery_charging_overlay"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:alpha="0.8"
                    android:elevation="1dp"
                    android:src="@drawable/ic_bolt_mini"
                    android:tint="?workspaceTextColor"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/battery_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:singleLine="true"
                android:textColor="?workspaceTextColor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/battery_percentage"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_battery_level_tag"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimaryInverse"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/battery_dots_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
